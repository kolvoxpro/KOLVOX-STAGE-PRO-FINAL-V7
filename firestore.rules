rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || request.auth != null;
    }

    // User profile and subcollections:
    // Allow users to store their songs, setlists, recordings, searches and logs
    match /users/{userId} {
      allow read, write: if request.auth != null || true;

      // Songs library
      match /songs/{songId} {
        allow read, write: if request.auth != null || true;
      }

      // Playlists / Setlists
      match /playlists/{playlistId} {
        allow read, write: if request.auth != null || true;

        match /songs/{itemSongId} {
          allow read, write: if request.auth != null || true;
        }
      }

      // Recordings
      match /recordings/{recordingId} {
        allow read, write: if request.auth != null || true;
      }

      // Search history
      match /search_history/{historyId} {
        allow read, write: if request.auth != null || true;
      }

      // Activity logs
      match /activity_logs/{logId} {
        allow read, write: if request.auth != null || true;
      }
    }
  }
}
